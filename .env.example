# Copy to .env (git-ignored) and change the values: cp .env.example .env
# Every variable docker-compose.yml reads is listed here with a dummy value.

# PostgreSQL superuser and database created on the first start
POSTGRES_USER=loantrack
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=loantrack

# Host port the frontend is published on (http://localhost:8080)
FRONTEND_PORT=8080
